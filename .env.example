# Firebase web app config (Firebase console > Project settings > Your apps > Web).
# These are not secrets. Leave them empty to run in demo mode (no Firebase).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Comma-separated Google accounts that see Manage / drag-to-reorder in the UI.
# The real permission is the ".write" rule in database.rules.json: keep both in sync.
VITE_OWNER_EMAILS=pookmeforai@gmail.com
